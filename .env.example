# Isi hanya di .env lokal. Jangan commit API key.
# OPENAI_API_KEY must belong to the provider configured by OPENAI_BASE_URL.
# For AgentRouter, uncomment the two lines below and use an AgentRouter key.
# OPENAI_BASE_URL=https://co.agentrouter.org/v1
# OPENAI_API_MODE=chat_completions
OPENAI_API_KEY=
# Pilih model yang mendukung Structured Outputs dan tersedia di project API Anda.
OPENAI_MODEL=gpt-4.1-mini
# For AgentRouter, select an available model ID, e.g. gpt-5.5.
OPENAI_AGENTS_DISABLE_TRACING=1
OPENAI_AGENTS_TRACE_INCLUDE_SENSITIVE_DATA=0
