flowchart LR
    subgraph ORCH["LANE 1 - ORCHESTRATOR DAN HASIL"]
        direction TB
        IN["FR dan Sequence Diagram tanpa label kesalahan"]
        SCOPE["Scope skenario, abstraksi, rulebook"]
        REPORT["Laporan otomatis: findings + evidence + coverage"]
        IN --> SCOPE
    end
    subgraph LLM["LANE 2 - LLM AGENTS"]
        direction TB
        A1["Agent 1: Requirements Extractor"]
        A2["Agent 2: Semantic Role/Behavior Alignment"]
        A3["Agent 3: Mapping Verifier"]
        A4["Agent 4: Report Generator"]
        A2 --> A3
    end
    subgraph PY["LANE 3 - PYTHON SERVICES"]
        direction TB
        P1["Mermaid Parser"]
        P2["IR Validator"]
        P3["Deterministic Checker R1-R7"]
        P4["Automatic Aggregator + Uncertainty Registry"]
        P3 --> P4
    end
    SCOPE --> A1
    SCOPE --> P1
    SCOPE -.-> P2
    A1 -->|Specification IR| P2
    P1 -->|Diagram IR| P2
    P2 -->|Elemen valid| A2
    P2 -.->|Tidak didukung => needs_review| P4
    A3 -->|Mapping diterima / ditolak / unmatched| P3
    A3 -.->|Mapping ambigu => needs_review| P4
    P2 -.->|IR tervalidasi| P3
    SCOPE -.-> P3
    P4 -->|Temuan terkunci| A4
    A4 --> REPORT
    P4 -.->|Fallback JSON otomatis| REPORT

    classDef input fill:#f8fafc,stroke:#475569,color:#0f172a
    classDef agent fill:#eff6ff,stroke:#2563eb,color:#172554
    classDef python fill:#f0fdfa,stroke:#0f766e,color:#134e4a
    class IN,SCOPE,REPORT input
    class A1,A2,A3,A4 agent
    class P1,P2,P3,P4 python
    style ORCH fill:#f8fafc,stroke:#cbd5e1,color:#0f172a
    style LLM fill:#eff6ff,stroke:#93c5fd,color:#172554
    style PY fill:#f0fdfa,stroke:#99f6e4,color:#134e4a
